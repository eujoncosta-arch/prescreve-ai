# ============================================================
# PRESCREVE-AI — Backend Environment Variables
# Copie para .env e preencha os valores reais
# ============================================================

# ── Banco de Dados ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/prescreve_ai?schema=public"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="troque-por-string-aleatoria-de-64-chars-minimo"
JWT_REFRESH_SECRET="troque-por-string-aleatoria-diferente-de-64-chars-minimo"

# ── MFA (TOTP, RFC 6238) ────────────────────────────────────────
# Chave de criptografia (AES-256-GCM) do segredo TOTP em repouso.
# OBRIGATÓRIA — 32 bytes em hexadecimal (64 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem esta variável, /auth/mfa/setup, /auth/mfa/ativar, /auth/mfa/desativar
# e o login de qualquer usuário com MFA ativo falham (fail-fast, por design
# — nunca um valor padrão hardcoded no código-fonte).
MFA_ENCRYPTION_KEY="troque-por-64-caracteres-hexadecimais-de-32-bytes-aleatorios"

# ── Pseudonimização de identificadores (CPF, CRM, IP) ──────────
# Chave HMAC-SHA256 usada para transformar CPF/CRM/IP (identificadores de
# baixa entropia) em hashes irreversíveis sem a chave. OBRIGATÓRIA — 32
# bytes em hexadecimal (64 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem esta variável, cadastro de médico com CRM, criação de consulta com
# CPF de paciente, e login com IP falham (fail-fast — nunca um hash sem
# segredo como fallback).
IDENTIFIER_HMAC_KEY="troque-por-64-caracteres-hexadecimais-de-32-bytes-aleatorios"

# ── Redis (opcional — sistema funciona sem Redis) ─────────────
# REDIS_URL="redis://localhost:6379"

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3001"

# ── Porta ─────────────────────────────────────────────────────
PORT=3000
