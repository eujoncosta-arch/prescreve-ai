# PRESCREVE-AI — Frontend — variáveis de ambiente
#
# Nenhuma delas é obrigatória para rodar `npm run dev`, mas o comportamento
# de autenticação MUDA de acordo com o que estiver configurado — ver
# PERSISTENCE_INTEGRITY_AUDIT_REPORT.md / OFFLINE_DEMO_MODE_AUDIT_REPORT.md
# para a matriz completa de ambientes.

# URL base do backend NestJS. Sem isso, login/registro/persistência exigem
# backend real e falham com erro claro (nunca criam uma sessão falsa) — a
# menos que NEXT_PUBLIC_DEMO_MODE esteja ativo (ver abaixo).
NEXT_PUBLIC_API_URL=

# Ambiente lógico da aplicação: production | staging | development.
# Se ausente, cai para NODE_ENV (definido automaticamente por `next dev`/
# `next build`). Qualquer valor desconhecido é tratado como "production"
# (fail-safe — nunca relaxa silenciosamente para o comportamento mais
# permissivo).
NEXT_PUBLIC_APP_ENV=development

# Ativa o MODO DEMONSTRAÇÃO — login simulado, sem chamadas reais ao
# backend, com uma faixa "MODO DEMONSTRAÇÃO" sempre visível na interface.
# Só tem efeito quando NEXT_PUBLIC_APP_ENV (ou NODE_ENV) resolve para algo
# DIFERENTE de "production" — em produção esta flag é sempre ignorada,
# mesmo que definida como "true" por engano. Útil para rodar o frontend
# localmente sem precisar de um backend real.
NEXT_PUBLIC_DEMO_MODE=false

# Segredo do gatilho manual de sync (POST /api/sync/eurofarma) — NUNCA
# prefixar com NEXT_PUBLIC_ (isso o embutiria no bundle do cliente).
# Comparado em tempo constante contra o header `Authorization: Bearer
# <token>`. Sem isso configurado, o endpoint fica BLOQUEADO em produção
# (fail-safe) e aberto fora de produção (uso local sem configuração).
EUROFARMA_SYNC_TOKEN=

# ── Observabilidade (Sentry) ────────────────────────────────────
# DSN do projeto Sentry (Next.js). O DSN de client não é secreto (é
# embutido no bundle por design do Sentry — por isso PRECISA do prefixo
# NEXT_PUBLIC_), mas mesmo assim fica em variável de ambiente, nunca
# hardcoded. Sem isso configurado, o SDK nunca inicializa (ver
# instrumentation-client.ts/instrumentation.ts) — nenhum evento é
# enviado a lugar nenhum. Ver docs/OBSERVABILITY-SENTRY.md.
NEXT_PUBLIC_SENTRY_DSN=

# Token de auth do Sentry (org-level, "Auth Token" em
# sentry.io/settings/account/api/auth-tokens) — usado SÓ no build para
# subir source maps legíveis ao Sentry. Nunca prefixar com NEXT_PUBLIC_.
# Sem isso, o build funciona normalmente, só sem source maps no Sentry
# (stack traces menos legíveis, não um erro).
SENTRY_AUTH_TOKEN=
